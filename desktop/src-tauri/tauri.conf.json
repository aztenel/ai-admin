{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI-admin Pult",
  "version": "0.1.0",
  "identifier": "kz.aiadmin.pult",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "AI-admin",
    "shortDescription": "Пульт чатов AI-администратора",
    "longDescription": "Переписка клиентов с ботом AI-администратора: ответы, заявки, уведомления о новых сообщениях.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"]
      }
    }
  }
}
