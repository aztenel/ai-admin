{
  // Имя должно совпадать с именем воркера в Cloudflare.
  "name": "ai-admin",
  "main": "worker.js",
  "compatibility_date": "2026-09-28",
  // Переменные и секреты (GEMINI_KEY, LEADS_KEY, MODEL и др.) заданы в панели Cloudflare.
  // keep_vars не даёт заливке их стереть.
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Фоновая задача раз в минуту: отправка рассылок (scheduled в worker.js). У черновиков она не работает — только у рабочего сайта.
  "triggers": { "crons": ["* * * * *"] },
  "kv_namespaces": [
    { "binding": "KV", "id": "29debedd4b844096b1c5c55eb30dd271" }
  ],
  // Боевая база D1 ai-admin — подключена по решению владельца (docs/runbooks/winchester-go-live.md). До выкладки этой правки
  // на ней применены миграции 0001–0006 и стоит отметка meta.stage = 'production': без отметки код базой не пользуется.
  "d1_databases": [
    { "binding": "DB", "database_name": "ai-admin", "database_id": "ea1610ed-d342-41ca-8170-40ffe81feb41", "migrations_dir": "migrations" }
  ],
  // Черновые версии (Worker Previews): у каждой ветки, кроме main, свой адрес; рабочий сайт они не трогают.
  // Без блока previews сборка черновой ветки падает с ошибкой «missing a previews block».
  // Черновик не наследует настройки рабочего сайта: всё, что ему нужно, указано здесь.
  // Переменные и секреты черновиков задаются в панели Cloudflare: Settings → Previews.
  // С 31.10.2026 у черновиков свои хранилища: KV ai-admin-dev и база D1 ai-admin-dev (до этого черновик писал в боевое
  // KV aiai — чаты, «стоп», счётчики). Боевых id здесь быть не должно: это проверяет test/unit/d1-schema.test.mjs.
  // У черновиков своя база D1 ai-admin-dev (блок previews заменяет боевую привязку DB целиком).
  "previews": {
    "vars": { "STAGE": "preview" },
    "kv_namespaces": [
      { "binding": "KV", "id": "0eafc39a31e9415997d05d41d012ae86" }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "ai-admin-dev",
        "database_id": "ecfe6f12-469b-440b-bd40-362f83a04e26",
        "migrations_dir": "migrations"
      }
    ]
  }
}
