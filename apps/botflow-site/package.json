{
  "name": "botflow-site",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Сайт студии TAYVENO (ИП Bot Flow): Astro + Tailwind, публикация — Cloudflare Worker tayveno (Workers Static Assets)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && tsc -p functions/tsconfig.json --noEmit",
    "check:meta": "node scripts/check-meta.mjs",
    "qa": "node scripts/qa.mjs",
    "images": "python3 scripts/images.py",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/golos-text": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261101.1",
    "typescript": "6.0.3",
    "wrangler": "4.153.0"
  }
}
