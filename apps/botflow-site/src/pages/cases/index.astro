---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Screenshot from "../../components/Screenshot.astro";
const cases = (await getCollection("cases")).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Работы" description="Проекты студии BOT FLOW, которые работают у клиентов: сайты, онлайн-запись, интеграции.">
  <section class="wrap pt-10 md:pt-16 lg:pt-20" aria-labelledby="page-title">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h1 id="page-title" class="t-h1 lg:col-span-7">Работы</h1>
      <p class="t-lead max-w-[560px] lg:col-span-5 lg:pb-1">Здесь только проекты, которые уже работают у клиентов. Новые добавляем после запуска.</p>
    </div>
  </section>
  <section class="wrap section pt-10! md:pt-14!" aria-label="Список проектов">
    <ul>
      {cases.map((c) => {
        const cover = c.data.screens[0];
        return (
          <li class="border-t border-border">
            <a href={`/cases/${c.id}/`} class="group grid gap-6 py-8 md:grid-cols-12 md:gap-6 lg:py-10">
              <div class="md:col-span-5 lg:col-span-4">
                <p class="t-small">{c.data.client} · {c.data.year}</p>
                <h2 class="t-h2 mt-2 transition-colors group-hover:text-accent">{c.data.title}</h2>
                <p class="t-small mt-4">{c.data.summary}</p>
                <p class="t-cap mt-4">{c.data.services.join(", ")}</p>
                <span class="mt-6 inline-flex items-center gap-2 text-[15px] font-semibold text-accent">Открыть кейс <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span></span>
              </div>
              <div class="md:col-span-7 lg:col-span-7 lg:col-start-6">
                {cover && <Screenshot name={cover.src} widths={cover.widths} ratio={cover.ratio} frame="16 / 10" alt={cover.alt} sizes="(min-width: 768px) 55vw, 92vw" class="transition-transform duration-300 group-hover:-translate-y-0.5" />}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
</Base>
