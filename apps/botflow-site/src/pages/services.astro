---
import { canContact, BRAND } from "../config/site";
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import { services } from "../lib/content";
---
<Base title="Услуги" description={`Разработка сайтов и веб-приложений, CRM и ERP, интеграции с 1С, банками, мессенджерами и сервисами записи, AI-автоматизация. Студия ${BRAND}, Казахстан.`}>
  <section class="wrap pt-10 md:pt-16 lg:pt-20" aria-labelledby="page-title">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <h1 id="page-title" class="t-h1 lg:col-span-7">Услуги</h1>
      <p class="t-lead max-w-[560px] lg:col-span-5 lg:pb-1">Четыре направления. Можно заказать одно или собрать из нескольких систему, в которой данные идут без ручного переноса.</p>
    </div>
    <nav aria-label="Направления на странице" class="mt-8 md:mt-10">
      <ul class="flex flex-wrap gap-2">
        {services.map((s) => (
          <li><a href={`#${s.slug}`} class="inline-flex min-h-10 items-center rounded-full px-4 text-[15px] font-medium text-heading ring-1 ring-inset ring-border transition-colors hover:bg-surface hover:ring-[#c4ccd6]">{s.title}</a></li>
        ))}
      </ul>
    </nav>
  </section>

  {services.map((s) => (
    <section id={s.slug} class="wrap section" aria-labelledby={`${s.slug}-title`}>
      <div class="grid gap-6 border-t border-border pt-8 lg:grid-cols-12 lg:pt-10">
        <div class="lg:col-span-4">
          <h2 id={`${s.slug}-title`} class="t-h2">{s.title}</h2>
        </div>
        <div class="lg:col-span-8">
          <p class="t-lead max-w-[718px] text-heading">{s.intro}</p>
          <div class="mt-8 grid gap-8 md:grid-cols-2 md:gap-6">
            <div>
              <h3 class="t-cap font-medium text-heading">Что можем сделать</h3>
              <ul class="mt-3">
                {s.can.map((x) => (
                  <li class="t-small border-t border-border py-2.5 first:border-0 first:pt-0">{x}</li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="t-cap font-medium text-heading">С чего начинаем</h3>
              <p class="t-small mt-3">{s.start}</p>
              {"case" in s && s.case && (
                <p class="t-small mt-5">Пример: <a class="link" href={s.case}>сайт и онлайн-запись для Winchester Barbershop</a></p>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  ))}

  {canContact() && <section class="wrap section" aria-labelledby="cta-title">
    <div class="grid gap-6 rounded-2xl bg-surface px-5 py-8 md:px-10 md:py-12 lg:grid-cols-12 lg:items-end lg:px-12">
      <div class="lg:col-span-7">
        <h2 id="cta-title" class="t-h2">Не уверены, что подходит?</h2>
        <p class="mt-4 max-w-[560px]">Опишите задачу своими словами. Подскажем, с какого направления начать и что можно сделать без лишней разработки.</p>
      </div>
      <div class="lg:col-span-4 lg:col-start-9 lg:justify-self-end">
        <Button href="/contacts/">Обсудить проект</Button>
      </div>
    </div>
  </section>}
</Base>
