// Публикация сайта TAYVENO: Cloudflare Worker «tayveno» только со статическими файлами (Workers Static Assets),
// без скрипта: заголовки безопасности и кэша берутся из dist/_headers (со скриптом и run_worker_first они бы
// не применялись — документация Cloudflare «Static Assets → Headers»).
// Сборка и выкладка — Cloudflare Workers Builds из ветки main, корень apps/botflow-site:
//   build: npm run build   deploy: npx wrangler deploy
// Своего домена в этом файле нет: tayveno.xyz привязывается в панели (Worker → Settings → Domains & Routes),
// когда зона tayveno.xyz активна в Cloudflare; иначе выкладка упала бы на поиске зоны.
// www.tayveno.xyz → tayveno.xyz — правилом Redirect Rules в зоне (см. README, «Публикация»).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tayveno",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": true,
  "preview_urls": false
}
